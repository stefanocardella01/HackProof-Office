  m_Script: {fileID: 11500000, guid: 865ad44b2396d9648a82838b6a0b3c3c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EmailInterfaceManager
  emails:
  - emailImage: {fileID: 21300000, guid: 218f7f3742f31bf4685ffb9e8a06994a, type: 3}
    subject: 'Documento condiviso: Bilancio 2026'
    visibleUrl: http://drive--google.com/d/6374pcjdsob83987cidkqwlsl9134
    correctType: 1
    explanation: "Questa \xE8 un'email di PHISHING. Nota attentamente l'URL: drive--google.com
      non \xE8 un dominio ufficiale di Google (che sarebbe drive.google.com). L'uso
      del doppio trattino serve a ingannare l'occhio. Inoltre, il link usa il protocollo
      HTTP non sicuro, cosa che Google non farebbe mai per i propri servizi."
  - emailImage: {fileID: 21300000, guid: bd8925e36bb0fe549814f88d740e9b3d, type: 3}
    subject: "Il tuo spazio Dropbox \xE8 esaurito"
    visibleUrl: https://www.dropbox.com/buy
    correctType: 0
    explanation: "Questa \xE8 un'email LEGITTIMA. Sebbene il messaggio crei urgenza
      (spazio esaurito), gli indicatori tecnici sono corretti. Il mittente dropboxmail.com
      \xE8 un dominio ufficiale verificato di Dropbox e il link punta direttamente
      al sito sicuro https://www.dropbox.com senza reindirizzamenti strani."
  - emailImage: {fileID: 21300000, guid: e7f5f57d4d841aa4a9dd39a5b9b2c4dc, type: 3}
    subject: Qualcuno ha la tua password
    visibleUrl: http://myaccount.google.com-securitysettingpage.ml-security.org/signonoptions/
    correctType: 1
    explanation: "Questa \xE8 un'email di PHISHING. L'URL \xE8 costruito per ingannare:
      la parte google.com \xE8 solo un sottodominio. Il vero dominio di destinazione
      \xE8 quello che precede il primo slash (/), ovvero ml-security.org. Google
      non ospiterebbe mai le sue pagine di sicurezza su un dominio esterno."
  - emailImage: {fileID: 21300000, guid: 8cb9dd1eb0729ff4abaecf6d06eedd85, type: 3}
    subject: Tentativo furto password bloccato
    visibleUrl: https://google.com/amp/tinyurl.com/y7u8ewlr
    correctType: 1
    explanation: "Questa \xE8 un'email di PHISHING. Gli hacker hanno usato un reindirizzamento
      tramite Google AMP (google.com/amp/...) per far sembrare il link sicuro all'inizio,
      ma la destinazione reale \xE8 mascherata da tinyurl.com. Una comunicazione
      di sicurezza ufficiale non userebbe mai un accorciatore di link (URL Shortener)."
  - emailImage: {fileID: 21300000, guid: 94438946a05c3ad42b1a7532e570de6f, type: 3}
    subject: 'Rispondi e Vinci: Frullatore Esclusivo'
    visibleUrl: https://d1 5k2d11r6t6rl.cloudfront.net/public/users/Integrators/d12425a2-57e5-44
    correctType: 1
    explanation: "Questa \xE8 un'email di PHISHING. Oltre all'offerta 'troppo bella
      per essere vera' (tattica dell'esca), guarda l'URL: punta a cloudfront.net
      (un servizio di hosting generico usato da chiunque) e non al dominio ufficiale
      di Coca-Cola. Le grandi aziende usano sempre i propri domini per i concorsi."
  emailCanvas: {fileID: 238756705}
  screenContainer: {fileID: 493768212}
  emailScreen: {fileID: 2106172071}
